rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // The app stores a single profile picture per user at
    // profile_pictures/{userId} (no file extension).
    match /profile_pictures/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isImageUpload();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Secure default: admins can access any storage prefix not explicitly
    // scoped above; regular users get no access unless a rule grants it.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
